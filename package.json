{
  "name": "audio-saas",
  "version": "1.0.0",
  "description": "Audio Processing SaaS — upload, transcribe, analyze with LLM",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:test:push": "DATABASE_URL=file:./test.db prisma db push --force-reset && DATABASE_URL=file:./test-api.db prisma db push --force-reset && DATABASE_URL=file:./test-pipeline.db prisma db push --force-reset && DATABASE_URL=file:./test-job-service.db prisma db push --force-reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "audio",
    "transcription",
    "llm",
    "saas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "form-data": "^4.0.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
